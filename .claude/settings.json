{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/doctrine_state.py hydrate --if-present"
          },
          {
            "type": "command",
            "command": "python tools/doctrine_metrics.py capture-hint"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/doctrine_engage.py"
          }
        ]
      }
    ]
  }
}
