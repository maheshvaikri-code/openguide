{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openguide.dev/spec/obc/obc-v0.1.schema.json",
  "title": "Open Behavioral Contract (OBC) v0.1",
  "description": "Declarative behavioral contract for an agent: invariants, phases, triggers, recovery, and tier-binding signals. One contract compiles to the strongest enforcement channel each model allows. Authored in TOML; this schema validates the decoded object.",
  "type": "object",
  "required": ["contract"],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "enforcement_floor": {
          "description": "Minimum tier the runtime must achieve or it refuses to run. t0=activation steering, t1=constrained decoding, t2=scheduled re-anchoring, t3=structural validation.",
          "type": "string",
          "enum": ["t0", "t1", "t2", "t3"],
          "default": "t3"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persona": { "type": "string" },
        "boundaries": { "type": "array", "items": { "type": "string" } }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "measure"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "measure": {
            "description": "Typed measure reference: judge:<name>, probe:<name>, structural:<name>, or external:<name>.",
            "type": "string",
            "pattern": "^(judge|probe|structural|external):[A-Za-z0-9_.-]+$"
          },
          "floor": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "weight": { "type": "number", "minimum": 0.0, "default": 1.0 },
          "hard": {
            "description": "If true the invariant is enforced at tier 1/3 and never advisory.",
            "type": "boolean",
            "default": false
          }
        },
        "anyOf": [
          { "required": ["floor"] },
          { "properties": { "hard": { "const": true } }, "required": ["hard"] }
        ]
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "window"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "window": {
            "type": "object",
            "required": ["turns"],
            "additionalProperties": false,
            "properties": {
              "turns": {
                "description": "[start, end] turn indices; end = -1 means 'to end of run'.",
                "type": "array",
                "items": { "type": "integer" },
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "signals": {
            "type": "array",
            "items": { "$ref": "#/$defs/signalBinding" }
          }
        }
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["on", "apply"],
        "additionalProperties": false,
        "properties": {
          "on": {
            "description": "Event predicate, e.g. 'token:<tool_call>' or 'state:drift>0.3'.",
            "type": "string",
            "minLength": 1
          },
          "apply": { "$ref": "#/$defs/signalBinding" }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drift_threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "actions": {
          "description": "Ordered recovery ladder. Each item is a verb optionally gated by @<drift>: re_anchor | escalate@0.45 | halt@0.60.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(re_anchor|escalate|halt)(@\\d+(\\.\\d+)?)?$"
          }
        }
      }
    },
    "signals": {
      "description": "Tier-binding indirection: maps a signal name to its pack (T0 vectors), T2 text template, and/or T1 grammar.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pack": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "t2_template": { "type": "string" },
          "t1_grammar": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "gain": {
      "description": "A scalar gain, or a schedule object that resolves to one over a window.",
      "oneOf": [
        { "type": "number" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ramp": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": ["ramp"]
        }
      ]
    },
    "signalBinding": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "gain": { "$ref": "#/$defs/gain" },
        "decay_tau": { "type": "number", "exclusiveMinimum": 0.0 }
      }
    }
  }
}
